# .env.local로 복사해 값을 채워요. 값은 커밋하지 않아요.

# Supabase 연결 문자열 (대시보드 상단 Connect). [YOUR-PASSWORD]를 DB 비밀번호로 바꿔 넣어요.
# 게임 서버용: Transaction pooler 주소 (포트 6543)
DATABASE_URL=
# 마이그레이션·스크립트용: Session pooler 주소 (포트 5432). 무료 플랜의 Direct connection은 IPv6 전용이라 쓰지 않아요.
DATABASE_URL_UNPOOLED=

# 플레이어 토큰 해시에 쓰는 비밀 값
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# 의견 보내기 메일 (Resend, https://resend.com). 받는 주소는 코드에 두지 않아요.
# 도메인을 인증하기 전에는 Resend 가입 메일 주소로만 보낼 수 있어요.
RESEND_API_KEY=
FEEDBACK_TO=
# 보내는 사람. 비우면 "농구 선수 키우기 <onboarding@resend.dev>"
FEEDBACK_FROM=
