{
  "name": "bench-to-ring",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/logos.mjs --quiet && node scripts/flags.mjs --quiet",
    "dev": "next dev",
    "prebuild": "node scripts/logos.mjs --quiet && node scripts/flags.mjs --quiet",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "vitest run --config vitest.balance.mts --reporter=verbose",
    "logos": "node scripts/logos.mjs",
    "flags": "node scripts/flags.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:rescore": "tsx scripts/rescore.mts"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "flag-icons": "7.5.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
