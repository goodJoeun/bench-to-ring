# .env.local로 복사해 값을 채워요. 값은 커밋하지 않아요.

# Neon 연결 문자열. 로컬은 dev 브랜치, 배포는 main 브랜치 주소를 써요.
# 게임 서버용: Connection pooling을 켠 주소 (호스트에 -pooler)
DATABASE_URL=
# 마이그레이션용: Connection pooling을 끈 주소
DATABASE_URL_UNPOOLED=

# 플레이어 토큰 해시에 쓰는 비밀 값
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
